{
  "name": "dsh-model-optimizer",
  "version": "1.6.0",
  "description": "模型自动优选 — automatic cost-tiered model failover for DeepSeek Harness: when a model fails, switch to the cheapest available one (free -> credits -> paid), with a pinned permanent fallback and per-route cooldown.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm",
    "failover",
    "model-selection",
    "cost-optimization"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
